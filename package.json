{
  "name": "pikpak-desktop-client",
  "version": "0.52.0",
  "description": "Independent PikPak desktop file browser and media client",
  "author": "PikPak Desktop contributors",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "node scripts/verify-ipc.mjs && node scripts/prepare-viewer.mjs && vite build && node scripts/verify-dist.mjs",
    "package:win": "npm run build && electron-builder --win portable",
    "stage:asar": "node scripts/stage-asar.cjs",
    "smoke": "node scripts/smoke.cjs",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "hls.js": "^1.7.2",
    "vue": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "latest",
    "concurrently": "latest",
    "electron": "44.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "26.1.0",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "local.pikpak.desktop",
    "productName": "PikPak Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "target": [
        "portable"
      ],
      "artifactName": "PikPak-Desktop-${version}-portable.${ext}"
    }
  }
}
